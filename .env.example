# LibTrial Environment Configuration
# Copy this file to .env and fill in your Gemini API key.
# DO NOT commit .env with real credentials.

# Required: Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: Gemma / Gemini Model Name (default: gemma-4-26b-a4b-it)
GEMMA_MODEL=gemma-4-26b-a4b-it
